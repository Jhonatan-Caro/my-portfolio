# Configuración de despliegue a S3 / CloudFront.
# Copia este archivo a .env.deploy y rellena tus valores.

# Nombre del bucket S3 destino (obligatorio)
S3_BUCKET=mi-bucket

CLOUDFRONT_DISTRIBUTION_ID=E123ABC456DEF

# Perfil / región de AWS a usar (opcional; los respeta la AWS CLI)
# AWS_PROFILE=personal
# AWS_REGION=eu-west-1
